{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@xenia/api", "dev"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@xenia/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "ai-concierge",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/dev-ai.sh"],
      "port": 8000
    }
  ]
}
