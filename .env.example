# ============================================================================
# Xenia environment template. Copy to .env and fill in. Never commit .env.
# ============================================================================

NODE_ENV=development

# --- Datastores (match infra/compose/docker-compose.yml) ---
# The app connects as the NON-superuser role (RLS is enforced for it).
DATABASE_URL=postgres://xenia_app:xenia_app@localhost:5442/xenia
# Migrations/seed connect as the privileged role (creates extensions/roles/RLS).
DATABASE_ADMIN_URL=postgres://xenia:xenia@localhost:5442/xenia
# Workers connect as the BYPASSRLS role (they operate across tenants).
WORKER_DATABASE_URL=postgres://xenia_worker:xenia_worker@localhost:5442/xenia
REDIS_URL=redis://localhost:6399

# --- Core API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
JWT_SECRET=change-me-in-prod-use-a-32-byte-random-string
MAGIC_LINK_SECRET=change-me-too
# Auth token lifetimes (sensible defaults applied if unset)
JWT_ACCESS_TTL=15m
JWT_MAGIC_TTL=2h
JWT_REFRESH_TTL_DAYS=30

# --- Web dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- AI Concierge service ---
AI_CONCIERGE_PORT=8000
AI_CONCIERGE_URL=http://localhost:8000
# Chat / generation provider ("the writer"): openai (default) | anthropic
LLM_PROVIDER=openai
# OpenAI — default writer. Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Anthropic — used only when LLM_PROVIDER=anthropic. Key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Embedding provider ("the librarian"): voyage (default) | openai
# Keep consistent between ingest & search; output dim must equal EMBED_DIM.
EMBEDDING_PROVIDER=voyage
# Voyage — default embeddings. Key: https://www.voyageai.com  (put real keys in .env, NOT here)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3
# OpenAI embeddings — used only when EMBEDDING_PROVIDER=openai (reuses OPENAI_API_KEY)
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1024

# --- Workers ---
WORKERS_CONCURRENCY=8

# --- Notifications (providers; leave blank to use the simulated provider) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=
SMTP_URL=

# --- Smart locks ---
# LOCK_PROVIDER=simulator | seam
LOCK_PROVIDER=simulator
SEAM_API_KEY=

# --- Billing ---
# Dummy provider signature until Stripe lands (docs/integrations/billing.md)
BILLING_WEBHOOK_SECRET=dev-billing-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=xenia
